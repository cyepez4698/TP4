state 0

    0 $accept: . unidad_traduccion $end
    1 unidad_traduccion: .
    2                  | . unidad_traduccion declaracion_externa

    $default  reduce using rule 1 (unidad_traduccion)

    unidad_traduccion  go to state 1


state 1

    0 $accept: unidad_traduccion . $end
    2 unidad_traduccion: unidad_traduccion . declaracion_externa
    3 declaracion_externa: . declaracion
    4                    | . definicion_funcion
    5                    | . error ';'
    6                    | . error SALTO_LINEA
    7 declaracion: . especificadores_declaracion lista_declaradores ';'
    8            | . especificadores_declaracion IDENTIFICADOR '(' parametros_optativos ')' ';'
   10 definicion_funcion: . especificadores_declaracion IDENTIFICADOR '(' parametros_optativos ')' @1 cuerpo_funcion
   12 especificadores_declaracion: . tipo_basico
   13                            | . SHORT tipo_basico_optativo
   14                            | . LONG tipo_basico_optativo
   15                            | . SIGNED tipo_basico_optativo
   16                            | . UNSIGNED tipo_basico_optativo
   17                            | . CONST especificadores_declaracion
   18                            | . VOLATILE especificadores_declaracion
   23 tipo_basico: . VOID
   24            | . CHAR
   25            | . INT
   26            | . FLOAT
   27            | . DOUBLE

    $end      shift, and go to state 2
    error     shift, and go to state 3
    VOID      shift, and go to state 4
    CHAR      shift, and go to state 5
    SHORT     shift, and go to state 6
    INT       shift, and go to state 7
    LONG      shift, and go to state 8
    FLOAT     shift, and go to state 9
    DOUBLE    shift, and go to state 10
    SIGNED    shift, and go to state 11
    UNSIGNED  shift, and go to state 12
    CONST     shift, and go to state 13
    VOLATILE  shift, and go to state 14

    declaracion_externa          go to state 15
    declaracion                  go to state 16
    definicion_funcion           go to state 17
    especificadores_declaracion  go to state 18
    tipo_basico                  go to state 19


