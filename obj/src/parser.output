Terminals which are not used

   AUTO
   REGISTER
   STATIC
   EXTERN
   TYPEDEF
   STRUCT
   UNION
   ENUM
   GOTO


Grammar

    0 $accept: unidad_traduccion $end

    1 unidad_traduccion: /* empty */
    2                  | unidad_traduccion declaracion_externa

    3 declaracion_externa: declaracion
    4                    | definicion_funcion
    5                    | error ';'
    6                    | error SALTO_LINEA

    7 declaracion: especificadores_declaracion lista_declaradores ';'
    8            | especificadores_declaracion IDENTIFICADOR '(' parametros_optativos ')' ';'

    9 @1: /* empty */

   10 definicion_funcion: especificadores_declaracion IDENTIFICADOR '(' parametros_optativos ')' @1 cuerpo_funcion

   11 cuerpo_funcion: '{' lista_elementos_optativa '}'

   12 especificadores_declaracion: tipo_basico
   13                            | SHORT tipo_basico_optativo
   14                            | LONG tipo_basico_optativo
   15                            | SIGNED tipo_basico_optativo
   16                            | UNSIGNED tipo_basico_optativo
   17                            | CONST especificadores_declaracion
   18                            | VOLATILE especificadores_declaracion

   19 tipo_basico_optativo: /* empty */
   20                     | tipo_basico
   21                     | LONG
   22                     | SHORT

   23 tipo_basico: VOID
   24            | CHAR
   25            | INT
   26            | FLOAT
   27            | DOUBLE

   28 lista_declaradores: declarador_inicializado
   29                   | lista_declaradores ',' declarador_inicializado

   30 declarador_inicializado: IDENTIFICADOR
   31                        | IDENTIFICADOR '=' expresion

   32 parametros_optativos: /* empty */
   33                     | lista_parametros

   34 lista_parametros: declaracion_parametro
   35                 | lista_parametros ',' declaracion_parametro

   36 declaracion_parametro: especificadores_declaracion IDENTIFICADOR
   37                      | especificadores_declaracion

   38 @2: /* empty */

   39 sentencia_compuesta: '{' @2 lista_elementos_optativa '}'

   40 lista_elementos_optativa: /* empty */
   41                         | lista_elementos

   42 lista_elementos: elemento
   43                | lista_elementos elemento

   44 elemento: declaracion
   45         | sentencia
   46         | error ';'
   47         | error SALTO_LINEA

   48 encabezado_if: IF '(' expresion ')'

   49 encabezado_switch: SWITCH '(' expresion ')'

   50 encabezado_while: WHILE '(' expresion ')'

   51 encabezado_for: FOR '(' expresion_optativa ';' expresion_optativa ';' expresion_optativa ')'

   52 sentencia: expresion_optativa ';'
   53          | sentencia_compuesta
   54          | encabezado_if sentencia
   55          | encabezado_if sentencia ELSE sentencia
   56          | encabezado_switch sentencia
   57          | encabezado_while sentencia
   58          | DO sentencia WHILE '(' expresion ')' ';'
   59          | encabezado_for sentencia
   60          | CASE CONSTANTE ':' sentencia
   61          | DEFAULT ':' sentencia
   62          | BREAK ';'
   63          | CONTINUE ';'
   64          | RETURN expresion_optativa ';'

   65 expresion_optativa: /* empty */
   66                   | expresion

   67 expresion: expresion_asignacion

   68 expresion_asignacion: expresion_logica_o
   69                     | expresion_unaria '=' expresion_asignacion
   70                     | expresion_unaria ASIGNACION_SUMA expresion_asignacion
   71                     | expresion_unaria ASIGNACION_RESTA expresion_asignacion
   72                     | expresion_unaria ASIGNACION_MULTIPLICACION expresion_asignacion
   73                     | expresion_unaria ASIGNACION_DIVISION expresion_asignacion

   74 expresion_logica_o: expresion_logica_y
   75                   | expresion_logica_o OP_O_LOGICO expresion_logica_y

   76 expresion_logica_y: expresion_igualdad
   77                   | expresion_logica_y OP_Y_LOGICO expresion_igualdad

   78 expresion_igualdad: expresion_relacional
   79                   | expresion_igualdad OP_IGUAL expresion_relacional
   80                   | expresion_igualdad OP_DISTINTO expresion_relacional

   81 expresion_relacional: expresion_aditiva
   82                     | expresion_relacional '<' expresion_aditiva
   83                     | expresion_relacional '>' expresion_aditiva
   84                     | expresion_relacional OP_MENOR_IGUAL expresion_aditiva
   85                     | expresion_relacional OP_MAYOR_IGUAL expresion_aditiva

   86 expresion_aditiva: expresion_multiplicativa
   87                  | expresion_aditiva '+' expresion_multiplicativa
   88                  | expresion_aditiva '-' expresion_multiplicativa

   89 expresion_multiplicativa: expresion_unaria
   90                         | expresion_multiplicativa '*' expresion_unaria
   91                         | expresion_multiplicativa '/' expresion_unaria

   92 expresion_unaria: expresion_postfija
   93                 | OP_INCREMENTO expresion_unaria
   94                 | OP_DECREMENTO expresion_unaria
   95                 | '+' expresion_unaria
   96                 | '-' expresion_unaria
   97                 | '!' expresion_unaria
   98                 | SIZEOF expresion_unaria

   99 expresion_postfija: expresion_primaria
  100                   | expresion_postfija '(' argumentos_optativos ')'
  101                   | expresion_postfija OP_INCREMENTO
  102                   | expresion_postfija OP_DECREMENTO

  103 expresion_primaria: IDENTIFICADOR
  104                   | CONSTANTE
  105                   | REAL
  106                   | LITERAL_CADENA
  107                   | CONSTANTE_CARACTER
  108                   | '(' expresion ')'

  109 argumentos_optativos: /* empty */
  110                     | lista_argumentos

  111 lista_argumentos: expresion
  112                 | lista_argumentos ',' expresion


